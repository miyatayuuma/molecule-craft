[
{"id":"methyl","nameJa":"メチル基","nameEn":"Methyl","aliases":[],"notation":"–CH₃","family":"skeleton","milestoneFamily":false,"description":"CH₃をまとめた置換基。メタンからHを1個取り去った形も学習対象です。炭素側の1か所から接続し、水素を付ける反復操作を省けます。","pattern":{"atoms":[{"element":"C","singleBondsOnly":true},{"element":"H"},{"element":"H"},{"element":"H"}],"bonds":[[0,1,1],[0,2,1],[0,3,1]]},"learningRole":"part"},
{"id":"isopropyl","nameJa":"イソプロピル基","nameEn":"Isopropyl","aliases":["プロパン-2-イル基"],"notation":"–CH(CH₃)₂","family":"skeleton","milestoneFamily":false,"description":"中央のCHから接続するC₃H₇。2個の末端CH₃と中央のHを確認します。直鎖や、Hを持たないtert-ブチルの接続中心とは区別します。","pattern":{"atoms":[{"element":"C","singleBondsOnly":true},{"element":"C","singleBondsOnly":true},{"element":"C","singleBondsOnly":true},{"element":"H"},{"element":"H"},{"element":"H"},{"element":"H"},{"element":"H"},{"element":"H"},{"element":"H"}],"bonds":[[0,1,1],[0,2,1],[0,3,1],[1,4,1],[1,5,1],[1,6,1],[2,7,1],[2,8,1],[2,9,1]]},"learningRole":"part"},
{"id":"n-butyl","nameJa":"n-ブチル基","nameEn":"n-Butyl","aliases":["ブチル基","ブタン-1-イル基"],"notation":"–CH₂CH₂CH₂CH₃","family":"skeleton","milestoneFamily":false,"description":"端のCH₂から接続する、直鎖4炭素のC₄H₉。各炭素のHも確認し、分岐や鎖の途中を接続点にするブチル基とは区別します。","pattern":{"atoms":[{"element":"C","singleBondsOnly":true},{"element":"C","singleBondsOnly":true},{"element":"C","singleBondsOnly":true},{"element":"C","singleBondsOnly":true},{"element":"H"},{"element":"H"},{"element":"H"},{"element":"H"},{"element":"H"},{"element":"H"},{"element":"H"},{"element":"H"},{"element":"H"}],"bonds":[[0,1,1],[1,2,1],[2,3,1],[0,4,1],[0,5,1],[1,6,1],[1,7,1],[2,8,1],[2,9,1],[3,10,1],[3,11,1],[3,12,1]]},"learningRole":"part"},
{"id":"alkene","nameJa":"炭素間二重結合","nameEn":"Alkene","notation":"C=C","family":"unsaturation","description":"炭素どうしが2組の電子対を共有する構造。芳香環内の結合とは分けて扱います。","pattern":{"atoms":[{"element":"C","aromatic":false},{"element":"C","aromatic":false}],"bonds":[[0,1,2]]},"learningRole":"motif"},
{"id":"alkyne","nameJa":"炭素間三重結合","nameEn":"Alkyne","notation":"C≡C","family":"unsaturation","description":"炭素どうしが3組の電子対を共有し、結合軸の周囲が直線状になります。","pattern":{"atoms":[{"element":"C"},{"element":"C"}],"bonds":[[0,1,3]]},"learningRole":"motif"},
{"id":"hydroxyl","nameJa":"ヒドロキシ基","nameEn":"Hydroxyl","notation":"–OH","family":"hydroxyl","description":"アルコールやフェノールに共通するOH。酸のOHはカルボキシ基の一部として区別します。","pattern":{"atoms":[{"element":"C","notCarbonyl":true},{"element":"O","degree":2},{"element":"H"}],"bonds":[[0,1,1],[1,2,1]]},"aliases":["水酸基"],"learningRole":"part"},
{"id":"ether","nameJa":"エーテル結合","nameEn":"Ether","notation":"C–O–C","family":"ether","description":"酸素が2つの炭素につながる構造。エステル・酸無水物の酸素は除きます。","pattern":{"atoms":[{"element":"C","notCarbonyl":true},{"element":"O","degree":2},{"element":"C","notCarbonyl":true}],"bonds":[[0,1,1],[1,2,1]]},"learningRole":"motif"},
{"id":"carbonyl","nameJa":"カルボニル基","nameEn":"Carbonyl","notation":"–C(=O)–","family":"carbonyl","description":"アルデヒド・ケトン・カルボン酸などに共通するC=O。ここではCO₂など無機分子のC=Oを除きます。","pattern":{"atoms":[{"element":"C","neighborElementsAny":["C","H","N"]},{"element":"O"}],"bonds":[[0,1,2]]},"aliases":[],"learningRole":"part"},
{"id":"aldehyde","nameJa":"ホルミル基","nameEn":"Formyl","notation":"–C(=O)H","family":"carbonyl","description":"カルボニル炭素にHが直接結合します。ギ酸のC–Hとは区別します。","pattern":{"atoms":[{"element":"C","singleNeighborElementsOnly":["C","H"]},{"element":"O"},{"element":"H"}],"bonds":[[0,1,2],[0,2,1]]},"aliases":["アルデヒド基"],"learningRole":"part"},
{"id":"ketone","nameJa":"ケトン構造","nameEn":"Ketone","notation":"C–C(=O)–C","family":"carbonyl","description":"カルボニル炭素の両側が炭素。アルデヒドとの接続の違いを比べられます。","pattern":{"atoms":[{"element":"C"},{"element":"O"},{"element":"C"},{"element":"C"}],"bonds":[[0,1,2],[0,2,1],[0,3,1]]},"learningRole":"motif"},
{"id":"carboxyl","nameJa":"カルボキシ基","nameEn":"Carboxyl","notation":"–C(=O)OH","family":"carboxyl","description":"同じ炭素に=Oと–OHが結合する構造。C–O–O–Hではありません。","pattern":{"atoms":[{"element":"C","neighborElementsAny":["C","H"]},{"element":"O"},{"element":"O","degree":2},{"element":"H"}],"bonds":[[0,1,2],[0,2,1],[2,3,1]]},"aliases":["カルボキシル基"],"learningRole":"part"},
{"id":"ester","nameJa":"エステル結合","nameEn":"Ester linkage","notation":"–C(=O)O–","family":"ester","description":"カルボン酸のOH側のHが炭素につながった形。酸無水物は区別します。","pattern":{"atoms":[{"element":"C"},{"element":"O"},{"element":"O","degree":2},{"element":"C","notCarbonyl":true}],"bonds":[[0,1,2],[0,2,1],[2,3,1]]},"aliases":[],"learningRole":"part"},
{"id":"amino","nameJa":"アミノ基","nameEn":"Amino","notation":"–NH₂","family":"amino","description":"炭素に結合したNH₂。アミドの窒素は別に分類します。第二級・第三級アミンはこのパターンの対象外です。","pattern":{"atoms":[{"element":"C","notCarbonyl":true},{"element":"N","degree":3},{"element":"H"},{"element":"H"}],"bonds":[[0,1,1],[1,2,1],[1,3,1]]},"aliases":[],"learningRole":"part"},
{"id":"amide","nameJa":"アミド結合","nameEn":"Amide","notation":"–C(=O)–N–","family":"amide","description":"カルボニル炭素と窒素が直接結合した構造。単なるアミノ基とは区別します。","pattern":{"atoms":[{"element":"C"},{"element":"O"},{"element":"N"}],"bonds":[[0,1,2],[0,2,1]]},"learningRole":"motif"},
{"id":"aromatic-ring","nameJa":"ベンゼン型芳香環","nameEn":"Benzene-type aromatic ring","notation":"交互結合の6員炭素環","family":"aromatic","description":"6個の炭素が環状につながる芳香族の基本骨格。この教材では交互の単・二重結合で表します。複素芳香環は対象外です。","pattern":{"atoms":[{"element":"C"},{"element":"C"},{"element":"C"},{"element":"C"},{"element":"C"},{"element":"C"}],"bonds":[[0,1,2],[1,2,1],[2,3,2],[3,4,1],[4,5,2],[5,0,1]]},"learningRole":"motif"},
{"id":"nitrile","nameJa":"シアノ基","nameEn":"Cyano","notation":"–C≡N","family":"nitrile","description":"炭素骨格につながるC≡N。C≡Cとは末端の元素が異なります。","pattern":{"atoms":[{"element":"C"},{"element":"C"},{"element":"N"}],"bonds":[[0,1,1],[1,2,3]]},"aliases":["ニトリル基"],"learningRole":"part"},
{"id":"thiol","nameJa":"チオール基","nameEn":"Thiol","notation":"–SH","family":"thiol","description":"炭素に結合したSH。OHの酸素を硫黄に置き換えた構造として比較できます。","pattern":{"atoms":[{"element":"C"},{"element":"S","degree":2},{"element":"H"}],"bonds":[[0,1,1],[1,2,1]]},"aliases":["スルファニル基","メルカプト基"],"learningRole":"part"},
{"id":"carbon-chain","nameJa":"飽和炭素鎖","nameEn":"Saturated carbon chain","notation":"C–C","family":"skeleton","description":"単結合だけを持つ炭素どうしのつながり。官能基ではなく、骨格づくりのための構造パターンです。","pattern":{"atoms":[{"element":"C","singleBondsOnly":true},{"element":"C","singleBondsOnly":true}],"bonds":[[0,1,1]]},"learningRole":"internal"},
{"id":"vinyl","nameJa":"ビニル基","nameEn":"Vinyl","aliases":["エテニル基"],"notation":"–CH=CH₂","family":"unsaturation","milestoneFamily":false,"description":"CH=CH₂をひとまとまりにした置換基。二重結合だけでなく、炭素に結合する3個のHまで確認します。結合次数を変えず、CH側の1か所から接続します。","pattern":{"atoms":[{"element":"C","aromatic":false},{"element":"C","aromatic":false},{"element":"H"},{"element":"H"},{"element":"H"}],"bonds":[[0,1,2],[0,2,1],[1,3,1],[1,4,1]]},"learningRole":"part"},
{"id":"ethynyl","nameJa":"エチニル基","nameEn":"Ethynyl","aliases":[],"notation":"–C≡CH","family":"unsaturation","milestoneFamily":false,"description":"C≡CHをひとまとまりにした置換基。末端のHを持つ三重結合から見つかります。Hのない炭素側が接続点です。","pattern":{"atoms":[{"element":"C"},{"element":"C"},{"element":"H"}],"bonds":[[0,1,3],[1,2,1]]},"learningRole":"part"},
{"id":"methoxy","nameJa":"メトキシ基","nameEn":"Methoxy","aliases":[],"notation":"–OCH₃","family":"ether","milestoneFamily":false,"description":"OCH₃をひとまとまりにした置換基。メタノール・メチルエーテル・メチルエステルなどで見つかります。酸素側の1か所から接続します。","pattern":{"atoms":[{"element":"O"},{"element":"C"},{"element":"H"},{"element":"H"},{"element":"H"}],"bonds":[[0,1,1],[1,2,1],[1,3,1],[1,4,1]]},"learningRole":"part"},
{"id":"ethyl","nameJa":"エチル基","nameEn":"Ethyl","aliases":[],"notation":"–CH₂CH₃","family":"skeleton","milestoneFamily":false,"description":"CH₂CH₃をひとまとまりにした置換基。単結合だけでなく、結合する5個のHまで確認します。CH₂側から接続します。","pattern":{"atoms":[{"element":"C","singleBondsOnly":true},{"element":"C","singleBondsOnly":true},{"element":"H"},{"element":"H"},{"element":"H"},{"element":"H"},{"element":"H"}],"bonds":[[0,1,1],[0,2,1],[0,3,1],[1,4,1],[1,5,1],[1,6,1]]},"learningRole":"part"},
{"id":"phenyl","nameJa":"フェニル基","nameEn":"Phenyl","aliases":[],"notation":"–C₆H₅","family":"aromatic","milestoneFamily":false,"description":"ベンゼンからHを1個取り去った形のC₆H₅。環の5個のHと交互結合を確認します。二置換ベンゼンの環そのものとは区別します。","pattern":{"atoms":[{"element":"C"},{"element":"C"},{"element":"C"},{"element":"C"},{"element":"C"},{"element":"C"},{"element":"H"},{"element":"H"},{"element":"H"},{"element":"H"},{"element":"H"}],"bonds":[[0,1,2],[1,2,1],[2,3,2],[3,4,1],[4,5,2],[5,0,1],[1,6,1],[2,7,1],[3,8,1],[4,9,1],[5,10,1]]},"learningRole":"part"},
{"id":"carbamoyl","nameJa":"カルバモイル基","nameEn":"Carbamoyl","aliases":[],"notation":"–C(=O)NH₂","family":"amide","milestoneFamily":false,"description":"C(=O)NH₂をひとまとまりにした置換基。アミド結合に加え、窒素につながる2個のHまで確認します。カルボニル炭素側から接続します。","pattern":{"atoms":[{"element":"C"},{"element":"O"},{"element":"N"},{"element":"H"},{"element":"H"}],"bonds":[[0,1,2],[0,2,1],[2,3,1],[2,4,1]]},"learningRole":"part"},
{"id":"nitro","nameJa":"ニトロ基","nameEn":"Nitro group","notation":"R–N(=O)–O","family":"nitro","description":"炭素につながるNと2個のOからなる基。教材の正準グラフは1本のN=Oと1本のN–Oを含み、分子内で2本のN–Oは等価に近づきます。","pattern":{"atoms":[{"element":"N","degree":3},{"element":"C"},{"element":"O"},{"element":"O"}],"bonds":[[0,1,1],[0,2,2],[0,3,1]]},"learningRole":"motif"},
{"id":"thioether","nameJa":"チオエーテル","nameEn":"Thioether","notation":"C–S–C","family":"sulfur","description":"硫黄が2個の炭素へ単結合した構造。S=Oを持つスルホキシドとは区別します。","pattern":{"atoms":[{"element":"S","degree":2,"singleBondsOnly":true},{"element":"C"},{"element":"C"}],"bonds":[[0,1,1],[0,2,1]]},"learningRole":"motif"},
{"id":"sulfoxide","nameJa":"スルホキシド","nameEn":"Sulfoxide","notation":"C–S(=O)–C","family":"sulfur","description":"2個の炭素と二重結合の酸素が硫黄につながる構造です。","pattern":{"atoms":[{"element":"S","degree":3},{"element":"C"},{"element":"C"},{"element":"O"}],"bonds":[[0,1,1],[0,2,1],[0,3,2]]},"learningRole":"motif"},
{"id":"acid-anhydride","nameJa":"酸無水物","nameEn":"Carboxylic acid anhydride","notation":"C(=O)–O–C(=O)","family":"acid-derivative","description":"2つのカルボニル炭素を1個の酸素がつなぐ構造。エステルとは区別されます。","pattern":{"atoms":[{"element":"C"},{"element":"O"},{"element":"O","degree":2},{"element":"C"},{"element":"O"}],"bonds":[[0,1,2],[0,2,1],[2,3,1],[3,4,2]]},"learningRole":"motif"},
{"id":"secondary-amine","nameJa":"第二級アミン","nameEn":"Secondary amine","notation":"R₂NH","family":"amine","description":"窒素が2個の炭素と1個の水素に単結合したアミン。カルボニル炭素に結合したアミド窒素は含みません。","pattern":{"atoms":[{"element":"N","degree":3,"notCarbonylBound":true},{"element":"C"},{"element":"C"},{"element":"H"}],"bonds":[[0,1,1],[0,2,1],[0,3,1]]},"learningRole":"motif"},
{"id":"tertiary-amine","nameJa":"第三級アミン","nameEn":"Tertiary amine","notation":"R₃N","family":"amine","description":"窒素が3個の炭素に単結合したアミン。カルボニル炭素に結合したアミド窒素は含みません。","pattern":{"atoms":[{"element":"N","degree":3,"notCarbonylBound":true},{"element":"C"},{"element":"C"},{"element":"C"}],"bonds":[[0,1,1],[0,2,1],[0,3,1]]},"learningRole":"motif"},
{"id":"carbon-halogen","nameJa":"炭素–ハロゲン結合","nameEn":"Carbon–halogen bond","notation":"C–X (X = F, Cl)","family":"halogen","description":"炭素とフッ素または塩素が単結合した部分構造です。アルキル・ビニル・芳香環の炭素を含みます。","pattern":{"atoms":[{"element":"C"},{"elementsAny":["F","Cl"]}],"bonds":[[0,1,1]]},"learningRole":"motif"},
{"id":"peroxide","nameJa":"過酸化物結合","nameEn":"Peroxide linkage","notation":"R–O–O–R","family":"peroxide","description":"それぞれ単結合だけを持つ酸素2個が、O–O単結合でつながる構造です。オゾンのO–Oとは区別します。","pattern":{"atoms":[{"element":"O","degree":2,"singleBondsOnly":true},{"element":"O","degree":2,"singleBondsOnly":true}],"bonds":[[0,1,1]]},"learningRole":"motif"}
]
