[
  {"id":"alkene","nameJa":"炭素間二重結合","nameEn":"Alkene","notation":"C=C","family":"unsaturation","description":"炭素どうしが2組の電子対を共有する構造。芳香環内の結合とは分けて扱います。","pattern":{"atoms":[{"element":"C","aromatic":false},{"element":"C","aromatic":false}],"bonds":[[0,1,2]]}},
  {"id":"alkyne","nameJa":"炭素間三重結合","nameEn":"Alkyne","notation":"C≡C","family":"unsaturation","description":"炭素どうしが3組の電子対を共有し、結合軸の周囲が直線状になります。","pattern":{"atoms":[{"element":"C"},{"element":"C"}],"bonds":[[0,1,3]]}},
  {"id":"hydroxyl","nameJa":"ヒドロキシ基","nameEn":"Hydroxyl","notation":"C–O–H","family":"hydroxyl","description":"アルコールやフェノールに共通するOH。酸のOHはカルボキシ基の一部として区別します。","pattern":{"atoms":[{"element":"C","notCarbonyl":true},{"element":"O","degree":2},{"element":"H"}],"bonds":[[0,1,1],[1,2,1]]}},
  {"id":"ether","nameJa":"エーテル結合","nameEn":"Ether","notation":"C–O–C","family":"ether","description":"酸素が2つの炭素につながる構造。エステル・酸無水物の酸素は除きます。","pattern":{"atoms":[{"element":"C","notCarbonyl":true},{"element":"O","degree":2},{"element":"C","notCarbonyl":true}],"bonds":[[0,1,1],[1,2,1]]}},
  {"id":"carbonyl","nameJa":"カルボニル基","nameEn":"Carbonyl","notation":"C=O","family":"carbonyl","description":"アルデヒド・ケトン・カルボン酸などに共通するC=O。ここではCO₂など無機分子のC=Oを除きます。","pattern":{"atoms":[{"element":"C","neighborElementsAny":["C","H","N"]},{"element":"O"}],"bonds":[[0,1,2]]}},
  {"id":"aldehyde","nameJa":"アルデヒド基","nameEn":"Aldehyde","notation":"–C(=O)H","family":"carbonyl","description":"カルボニル炭素にHが直接結合します。ギ酸のC–Hとは区別します。","pattern":{"atoms":[{"element":"C","singleNeighborElementsOnly":["C","H"]},{"element":"O"},{"element":"H"}],"bonds":[[0,1,2],[0,2,1]]}},
  {"id":"ketone","nameJa":"ケトン構造","nameEn":"Ketone","notation":"C–C(=O)–C","family":"carbonyl","description":"カルボニル炭素の両側が炭素。アルデヒドとの接続の違いを比べられます。","pattern":{"atoms":[{"element":"C"},{"element":"O"},{"element":"C"},{"element":"C"}],"bonds":[[0,1,2],[0,2,1],[0,3,1]]}},
  {"id":"carboxyl","nameJa":"カルボキシ基","nameEn":"Carboxyl","notation":"–C(=O)–OH","family":"carboxyl","description":"同じ炭素に=Oと–OHが結合する構造。C–O–O–Hではありません。","pattern":{"atoms":[{"element":"C","neighborElementsAny":["C","H"]},{"element":"O"},{"element":"O","degree":2},{"element":"H"}],"bonds":[[0,1,2],[0,2,1],[2,3,1]]}},
  {"id":"ester","nameJa":"エステル結合","nameEn":"Ester","notation":"–C(=O)–O–C","family":"ester","description":"カルボン酸のOH側のHが炭素につながった形。酸無水物は区別します。","pattern":{"atoms":[{"element":"C"},{"element":"O"},{"element":"O","degree":2},{"element":"C","notCarbonyl":true}],"bonds":[[0,1,2],[0,2,1],[2,3,1]]}},
  {"id":"amino","nameJa":"アミノ基（第一級）","nameEn":"Primary amino","notation":"C–NH₂","family":"amino","description":"炭素に結合したNH₂。アミドの窒素は別に分類します。第二級・第三級アミンはこのパターンの対象外です。","pattern":{"atoms":[{"element":"C","notCarbonyl":true},{"element":"N","degree":3},{"element":"H"},{"element":"H"}],"bonds":[[0,1,1],[1,2,1],[1,3,1]]}},
  {"id":"amide","nameJa":"アミド結合","nameEn":"Amide","notation":"–C(=O)–N–","family":"amide","description":"カルボニル炭素と窒素が直接結合した構造。単なるアミノ基とは区別します。","pattern":{"atoms":[{"element":"C"},{"element":"O"},{"element":"N"}],"bonds":[[0,1,2],[0,2,1]]}},
  {"id":"aromatic-ring","nameJa":"ベンゼン型芳香環","nameEn":"Benzene-type aromatic ring","notation":"交互結合の6員炭素環","family":"aromatic","description":"6個の炭素が環状につながる芳香族の基本骨格。この教材では交互の単・二重結合で表します。複素芳香環は対象外です。","pattern":{"atoms":[{"element":"C"},{"element":"C"},{"element":"C"},{"element":"C"},{"element":"C"},{"element":"C"}],"bonds":[[0,1,2],[1,2,1],[2,3,2],[3,4,1],[4,5,2],[5,0,1]]}},
  {"id":"nitrile","nameJa":"ニトリル基","nameEn":"Nitrile","notation":"C–C≡N","family":"nitrile","description":"炭素骨格につながるC≡N。C≡Cとは末端の元素が異なります。","pattern":{"atoms":[{"element":"C"},{"element":"C"},{"element":"N"}],"bonds":[[0,1,1],[1,2,3]]}},
  {"id":"thiol","nameJa":"チオール基","nameEn":"Thiol","notation":"C–S–H","family":"thiol","description":"炭素に結合したSH。OHの酸素を硫黄に置き換えた構造として比較できます。","pattern":{"atoms":[{"element":"C"},{"element":"S","degree":2},{"element":"H"}],"bonds":[[0,1,1],[1,2,1]]}},
  {"id":"carbon-chain","nameJa":"飽和炭素鎖","nameEn":"Saturated carbon chain","notation":"C–C","family":"skeleton","description":"単結合だけを持つ炭素どうしのつながり。官能基ではなく、骨格づくりのための構造パターンです。","pattern":{"atoms":[{"element":"C","singleBondsOnly":true},{"element":"C","singleBondsOnly":true}],"bonds":[[0,1,1]]}}
]
